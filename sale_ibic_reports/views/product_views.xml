<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- Product Template: Packaging Information tab                        -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <record id="product_template_form_packaging_inherit" model="ir.ui.view">
    <field name="name">product.template.form.ibic.packaging</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">

      <xpath expr="//notebook/page[last()]" position="after">
        <page string="Packaging Information" name="ibic_packaging">

          <!-- Info banner -->
          <div class="alert alert-info" role="alert"
               style="margin-bottom:12px; font-size:12px;">
            Product Weight and Base UOM are inherited automatically from
            Product Inventory settings.
          </div>

          <!-- ── Inventory Reference: UOM + Weight ─────────────────── -->
          <group string="Product Base Settings" col="4">
            <field name="uom_id"
                   string="Unit of Measure"
                   readonly="0"
                   groups="uom.group_uom"
                   colspan="2"
                   options="{'no_create': True}"/>

            <field name="uom_ids" widget="many2many_tags"
                   groups="uom.group_uom"
                   colspan="2"
                   options="{'no_create': True}"/>
            <field name="weight"
                   string="Weight (KG)"
                   readonly="0"
                   colspan="2"/>
          </group>

          <!-- ── Packagings (product.packaging O2M) ────────────────── -->

          <!-- ── Custom Packaging Information Fields ────────────────── -->
          <group string="Packaging Information" col="6">
            <field name="pkg_cartons_per_ton"            colspan="2"/>
            <field name="pkg_carton_weight_kg_id"        colspan="2"/>
            <field name="pkg_units_per_carton"           colspan="2"/>
            <field name="pkg_wood_pallet_weight"         colspan="2"/>
            <field name="pkg_plastic_pallet_weight"      colspan="2"/>
            <field name="pkg_default_pallet_qty_per_ton" colspan="2"/>
          </group>

        </page>
      </xpath>

    </field>
  </record>

  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <!-- kg.weight form + list + action                                     -->
  <!-- ═══════════════════════════════════════════════════════════════════ -->
  <record id="kg_weight_form_view" model="ir.ui.view">
    <field name="name">kg.weight.form</field>
    <field name="model">kg.weight</field>
    <field name="arch" type="xml">
      <form string="KG Weight">
        <sheet>
          <group>
            <field name="name"/>
            <field name="value"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="kg_weight_tree_view" model="ir.ui.view">
    <field name="name">kg.weight.list</field>
    <field name="model">kg.weight</field>
    <field name="arch" type="xml">
      <list string="KG Weights" editable="bottom">
        <field name="name"/>
        <field name="value"/>
        <field name="active"/>
      </list>
    </field>
  </record>

  <record id="action_kg_weight" model="ir.actions.act_window">
    <field name="name">Carton KG Weights</field>
    <field name="res_model">kg.weight</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_kg_weight"
            name="Carton KG Weights"
            parent="sale.product_menu_catalog"
            action="action_kg_weight"
            sequence="99"/>

</odoo>
