<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="stock_picking_form_ibic_packing" model="ir.ui.view">
    <field name="name">stock.picking.form.ibic.packing</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form"/>
    <field name="arch" type="xml">

      <!-- Print button after Validate -->
      <xpath expr="//button[@name='button_validate']" position="after">
        <button name="%(sale_ibic_reports.action_stock_picking_packing_list_report)d"
                string="🖨 Packing List"
                type="action"
                class="btn btn-secondary"
                invisible="not sp_packing_line_ids"/>
      </xpath>

      <!-- New Packing Information tab -->
      <xpath expr="//notebook" position="inside">
        <page string="Packing Information" name="ibic_packing">

          <group col="4" string="Packing Information">
            <field name="sp_container_type" colspan="2"/>
            <field name="sp_print_type"     colspan="2"/>
            <field name="sp_bl_number"      colspan="2"/>
            <button name="action_populate_packing_lines"
                    string="↺ Load from Transfer Lines"
                    type="object"
                    class="btn btn-secondary"
                    colspan="2"
                    confirm="This will add packing lines from the current transfer moves. Continue?"/>
          </group>

          <field name="sp_packing_line_ids" nolabel="1">
            <list editable="bottom">
              <field name="sequence"      widget="handle"/>
              <field name="container_no"  optional="show"/>
              <field name="move_id"       optional="hide"
                     domain="[('picking_id','=',parent.id)]"/>
              <field name="product_id"    optional="show"/>
              <field name="uom_id"        optional="show" readonly="1"/>
              <field name="sale_qty"      optional="show" readonly="1"
                     string="Sale Qty"/>
              <field name="qty"           optional="show"
                     string="Qty (TON)"   digits="[16,3]"/>
              <field name="qty_cartons"   optional="show"/>
              <field name="pallet_type"   optional="show"/>
              <field name="pallet_weight" optional="show"
                     string="Pallet Weight (KG)"/>
              <field name="pallet_qty"    optional="show"/>
              <field name="carton_nw_kg"  optional="show"
                     string="Carton N.W (TON)"/>
              <field name="carton_gw_kg"  optional="show"
                     string="Carton G.W (TON)"/>
              <field name="nw_kg"         optional="show"
                     readonly="1" string="NW KG"/>
              <field name="gw_kg"         optional="show"
                     readonly="1" string="GW KG"/>
            </list>
          </field>

          <!-- Summary -->
          <group string="Summary" col="3">
            <group string="Quantities" col="2">
              <field name="sp_total_qty_ton"         readonly="1"/>
              <field name="sp_total_qty_cartons"     readonly="1"/>
              <field name="sp_total_wood_pallets"    readonly="1"/>
              <field name="sp_total_plastic_pallets" readonly="1"/>
              <field name="sp_total_pallets"         readonly="1"/>
            </group>
            <group string="KG Totals" col="2">
<!--              <field name="sp_total_carton_weight_kg" readonly="1"/>-->
              <field name="sp_total_carton_nw_kg"     readonly="1"/>
              <field name="sp_total_carton_gw_kg"     readonly="1"/>
              <field name="sp_total_nw_kg"            readonly="1"/>
              <field name="sp_total_gw_kg"            readonly="1"/>
            </group>
            <group string="LB Totals" col="2">
<!--              <field name="sp_total_carton_weight_lb" readonly="1"/>-->
              <field name="sp_total_carton_nw_lb"     readonly="1"/>
              <field name="sp_total_carton_gw_lb"     readonly="1"/>
<!--              <field name="sp_total_nw_lb"            readonly="1"/>-->
<!--              <field name="sp_total_gw_lb"            readonly="1"/>-->
            </group>
          </group>

        </page>
      </xpath>

    </field>
  </record>

</odoo>
