<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Invoice Proforma Invoice ── -->
  <record id="action_report_invoice_ibic_proforma" model="ir.actions.report">
    <field name="name">Invoice (IBIC)</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">sale_ibic_reports.invoice_proforma_document</field>
    <field name="report_file">sale_ibic_reports.invoice_proforma_document</field>
    <field name="print_report_name">'Proforma_Invoice_%s' % object.name</field>
    <field name="paperformat_id" ref="paperformat_ibic_a4"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>

  <!-- ── Invoice Packing List ── -->
  <record id="action_report_invoice_ibic_packing" model="ir.actions.report">
    <field name="name">Packing List (IBIC)</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">sale_ibic_reports.invoice_packing_list_document</field>
    <field name="report_file">sale_ibic_reports.invoice_packing_list_document</field>
    <field name="print_report_name">'Packing_List_%s' % object.name</field>
    <field name="paperformat_id" ref="paperformat_ibic_a4"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
  </record>

</odoo>
