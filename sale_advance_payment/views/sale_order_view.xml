<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Extend Sale Order Form ── -->
        <record id="view_sale_order_form_advance_payment" model="ir.ui.view">
            <field name="name">sale.order.form.advance.payment</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <!-- Add Advance Payment button in header -->
                <xpath expr="//header/button[last()]" position="after">
                    <button name="action_register_advance_payment"
                            string="Advance Payment"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['sale', 'done']"
                            icon="fa-money"/>
                </xpath>

                <!-- Add Advance Payments tab -->
                <xpath expr="//page[last()]" position="after">
                    <page string="Payment Advance"
                          name="advance_payment_tab"
                          invisible="state not in ['sale', 'done']">
                        <group>
                            <group>
                                <field name="advance_payment_total"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       readonly="1"/>
                            </group>
                            <group>
                                <field name="advance_payment_count"
                                       string="Total Payments"
                                       readonly="1"/>
                            </group>
                        </group>
                        <field name="advance_payment_ids"
                               readonly="1"
                               nolabel="1">
                            <list>
                                <field name="payment_date" string="Date"/>
                                <field name="journal_id" string="Journal"/>
                                <field name="memo" string="Memo"/>
                                <field name="payment_reference" string="Reference"/>
                                <field name="amount"
                                       string="Amount"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" string="Currency" optional="show"/>
                                <field name="state"
                                       string="Status"
                                       widget="badge"
                                       decoration-success="state == 'posted'"
                                       decoration-warning="state == 'draft'"
                                       decoration-danger="state == 'cancel'"/>
                                <field name="payment_id"
                                       string="Payment"
                                       optional="show"/>
                            </list>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
