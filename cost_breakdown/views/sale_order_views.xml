<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_cost_breakdown" model="ir.ui.view">
        <field name="name">sale.order.form.cost.breakdown</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Smart button — always opens list view -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_view_cost_breakdowns"
                        class="oe_stat_button"
                        icon="fa-calculator"
                        invisible="cost_breakdown_count == 0">
                    <field name="cost_breakdown_count" widget="statinfo"
                           string="Est. Cost Breakdowns"/>
                </button>
            </xpath>

            <!-- "Create Estimated Cost Breakdown" button -->
            <xpath expr="//button[@name='action_confirm']" position="before">
                <button name="action_create_cost_breakdown"
                        type="object"
                        string="Create Estimated Cost Breakdown"
                        class="btn-secondary"
                        icon="fa-calculator"
                        invisible="state in ('cancel',)"/>
            </xpath>

        </field>
    </record>

</odoo>
