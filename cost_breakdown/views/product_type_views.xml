<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────── -->
    <record id="view_product_type_list" model="ir.ui.view">
        <field name="name">product.type.list</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <list string="Product Natures" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────── -->
    <record id="view_product_type_form" model="ir.ui.view">
        <field name="name">product.type.form</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <form string="Product Nature">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nature Name…"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────── -->
    <record id="action_product_type" model="ir.actions.act_window">
        <field name="name">Product Natures</field>
        <field name="res_model">product.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
