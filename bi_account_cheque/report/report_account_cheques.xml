<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_account_cheques" model="ir.actions.report">
        <field name="name">Cheques</field>
        <field name="model">account.cheque</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bi_account_cheque.report_account_cheques_template</field>
        <field name="report_file">bi_account_cheque.report_account_cheques_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_account_cheques_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="doc"/>
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row">
                        <h4 class="text-center">
                            <b t-if="cheques_type == 'incoming'">Incoming Cheques Report</b>
                            <b t-elif="cheques_type == 'outgoing'">Outgoing Cheques Report</b>
                            <b t-else="">Cheques Report</b>
                        </h4>
                    </div>

                    <div class="row mt32 mb32" id="information">
                        <div class="col-6">
                            <strong>Start Date:</strong>
                            <p t-esc="from_date"/>
                        </div>
    
                        <div class="col-6">
                            <strong>End Date:</strong>
                            <p t-esc="to_date"/>
                        </div>
                    </div>

                    <br/>

                    <table class="table table-striped">
                        <thead class="thead-light">
                            <tr>
                                <th>Name</th>
                                <th>Bank</th>
                                <th>Cheque Number</th>
                                <th>Amount</th>
                                <th>Partner</th>
                                <th>Date</th>
                                <th t-if="cheques_type != 'outgoing'">Cheque Receive Date</th>
                                <th t-if="cheques_type != 'incoming'">Cheque Given Date</th>
                                <th>Credit Account</th>
                                <th>Debit Account</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td><span t-field="o.name"/></td>
                                    <td><span t-field="o.bank_id.display_name"/></td>
                                    <td><span t-field="o.cheque_number"/></td>
                                    <td><span t-field="o.amount"/></td>
                                    <td><span t-field="o.partner_id.display_name"/></td>
                                    <td><span t-field="o.date"/></td>
                                    <td t-if="o.cheque_type == 'incoming'"><span t-field="o.cheque_receive_date"/></td>
                                    <td t-if="not cheques_type"/>
                                    <td t-if="o.cheque_type == 'outgoing'"><span t-field="o.cheque_given_date"/></td>
                                    <td><span t-field="o.credit_account_id.display_name"/></td>
                                    <td><span t-field="o.debit_account_id.display_name"/></td>
                                    <td><span t-field="o.state"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
