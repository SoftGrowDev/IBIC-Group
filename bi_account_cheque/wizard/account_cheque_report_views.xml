<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- VIEWS -->

    <record id="view_account_cheque_report_form" model="ir.ui.view">
        <field name="name">account.cheque.report.form</field>
        <field name="model">account.cheque.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="from_date"/>
                    </group>
                    <group>
                        <field name="to_date"/>
                    </group>
                </group>
                <group>
                    <field name="cheques_type"/>
                </group>
                <footer>
                    <button string="Print" class="btn-primary" name="action_print" type="object" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ACTIONS (WINDOW) -->

    <record id="action_account_cheques_report" model="ir.actions.act_window">
        <field name="name">Cheques Report</field>
        <field name="res_model">account.cheque.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- MENU ITEMS -->

    <menuitem id="account_cheques_report_menu"
              parent="account.menu_finance_reports"
              action="action_account_cheques_report"
              sequence="5"/>
</odoo>
