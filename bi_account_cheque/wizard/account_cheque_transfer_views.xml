<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_cheque_transfer_form" model="ir.ui.view">
        <field name="name">account.cheque.transfer.form</field>
        <field name="model">account.cheque.transfer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="contact_id"/>
                </group>
                <footer>
                    <button string="Transfer" class="btn-primary" name="action_transfer" type="object" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_cheques_transfer" model="ir.actions.act_window">
        <field name="name">Transfer</field>
        <field name="res_model">account.cheque.transfer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
