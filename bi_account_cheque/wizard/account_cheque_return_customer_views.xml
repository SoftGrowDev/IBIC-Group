<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_cheque_return_customer_form" model="ir.ui.view">
        <field name="name">account.cheque.return.customer.form</field>
        <field name="model">account.cheque.return.customer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                </group>
                <footer>
                    <button string="Return to Customer" class="btn-primary" name="action_return_customer"
                            type="object" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_cheques_return_customer" model="ir.actions.act_window">
        <field name="name">Return to Customer</field>
        <field name="res_model">account.cheque.return.customer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
