<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_cheque_return_form" model="ir.ui.view">
        <field name="name">account.cheque.return.form</field>
        <field name="model">account.cheque.return</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Return" class="btn-primary" name="action_return" type="object" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_cheques_return" model="ir.actions.act_window">
        <field name="name">Return</field>
        <field name="res_model">account.cheque.return</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
