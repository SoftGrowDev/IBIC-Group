<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_cheque_cash_form" model="ir.ui.view">
        <field name="name">account.cheque.cash.form</field>
        <field name="model">account.cheque.cash</field>
        <field name="arch" type="xml">
            <form string="Cheque">
                <group>
                    <field name="date"/>
                    <field name="account_id"/>
                    <field name="amount"/>
                </group>
                <footer>
                    <button string="Cash" class="btn-primary" name="action_cash" type="object" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_cheques_cash" model="ir.actions.act_window">
        <field name="name">Cash</field>
        <field name="res_model">account.cheque.cash</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
