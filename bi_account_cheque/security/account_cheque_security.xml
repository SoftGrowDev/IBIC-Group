<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_show_cheque_menu" model="res.groups">
        <field name="name">Show Cheques Management Menu</field>
    </record>

    <record id="account_cheque_multi_company_rule" model="ir.rule">
        <field name="name">Account Cheque multi-company</field>
        <field name="model_id" ref="model_account_cheque"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>

    <record id="journal_multi_company_rule" model="ir.rule">
        <field name="name">Journal multi-company</field>
        <field name="model_id" ref="account.model_account_journal"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
    </record>
</odoo>
