    <!-- ACTIONS (WINDOW) -->

    <record id="action_account_cheques_reporting" model="ir.actions.act_window">
        <field name="name">Cheques Reporting</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.cheque</field>
        <field name="view_mode">list,pivot</field>
        <field name="view_id" ref="bi_account_cheque.view_account_cheque_reporting_tree"/>
        <field name="target">current</field>
    </record>

    <record id="action_incoming_account_cheques" model="ir.actions.act_window">
        <field name="name">Incoming Account Cheques</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bi_account_cheque.view_account_cheque_tree"/>
        <field name="context">{'default_cheque_type': 'incoming'}</field>
        <field name="domain">[('cheque_type', '=', 'incoming')]</field>
    </record>

    <record id="action_outgoing_account_cheques" model="ir.actions.act_window">
        <field name="name">Outgoing Account Cheques</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.cheque</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="bi_account_cheque.view_account_cheque_tree"/>
        <field name="context">{'default_cheque_type': 'outgoing'}</field>
        <field name="domain">[('cheque_type', '=', 'outgoing')]</field>
    </record>

    <!-- MENU ITEMS -->

    <menuitem id="account_cheques_menu"
              name="Cheques Management"
              parent="accountant.menu_accounting"

              groups="bi_account_cheque.group_show_cheque_menu"
              sequence="5">
        <menuitem id="incoming_account_cheques_menu"
                  action="action_incoming_account_cheques"
                  sequence="1"/>
        <menuitem id="outgoing_account_cheques_menu"
                  action="action_outgoing_account_cheques"
                  sequence="2"/>
        <menuitem id="menu_account_cheques_reporting"
                  name="Reporting"
                  sequence="3">
            <menuitem id="account_cheques_reporting_menu"
                      name="Cheques"
                      action="action_account_cheques_reporting"
                      sequence="1"/>
        </menuitem>
    </menuitem>
</odoo>
