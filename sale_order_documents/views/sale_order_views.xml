<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_order_form_documents" model="ir.ui.view">
        <field name="name">sale.order.form.documents</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Documents" name="sale_documents">

                    <field name="document_ids">

                        <list editable="bottom">
                            <field name="name_id"/>
                            <field name="attachment_id"/>
                        </list>

                    </field>

                </page>

            </xpath>

        </field>
    </record>

    <record id="sale_document_name_tree" model="ir.ui.view">
        <field name="name">sale.document.name.tree</field>
        <field name="model">sale.document.name</field>
        <!--<field name="field_parent">children_ids if_want_to_add_Childs</field>-->
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="sale_document_name_action" model="ir.actions.act_window">
        <field name="name">Sale Document Name</field>
        <field name="res_model">sale.document.name</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="sale_document_name_menu"
              name="Sale Document Name"
              action="sale_document_name_action"
              parent="sale.menu_sale_config"
              sequence="50"/>

</odoo>
