<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_analytic_line_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">
                    <h2>Analytic USD Report</h2>

                    <t t-set="lines"
                       t-value="env['account.analytic.line'].search([
                            ('date', '&gt;=', doc.date_from),
                            ('date', '&lt;=', doc.date_to)
                       ])"/>

                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Amount</th>
                                <th>USD Rate</th>
                                <th>USD Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr t-foreach="lines" t-as="line">
                                <td>
                                    <span t-field="line.date"/>
                                </td>

                                <td>
                                    <span t-field="line.name"/>
                                </td>

                                <td>
                                    <span t-field="line.product_id"/>
                                </td>

                                <td>
                                    <span t-field="line.product_categ_id"/>
                                </td>

                                <td>
                                    <span t-field="line.amount"/>
                                </td>

                                <td>
                                    <span t-field="line.usd_rate"/>
                                </td>

                                <td>
                                    <span t-field="line.usd_amount"/>
                                </td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </t>
        </t>
    </template>

</odoo>
